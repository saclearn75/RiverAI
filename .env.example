# Copy this file to .env and set the API key before running the demo.
RIVERAI_API_KEY=

# River model and local repository configuration.
ENGINE=Qwen/Qwen3.6-35B-A3B-FP8
REPO_ROOT=.
CHECKPOINT_NAME=gsm8k-demo-checkpoint

# Bounded GSM8K RL experiment settings.
BATCH_SIZE=16
GROUP_SIZE=4
MAX_TOKENS=256
MAX_STEPS=5
EVAL_SIZE=30
LORA_RANK=8
LEARNING_RATE=4e-5
STOP_TOKEN=<|im_end|>
EVAL_SEED_BASE=20260921
